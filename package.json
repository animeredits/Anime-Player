{
    "name": "anime-player",
    "version": "1.3.7",
    "description": "Anime Player is an advanced player for anime enthusiasts. Enjoy your favorite anime with enhanced controls.",
    "main": "./src/main.js",
    "author": "Anime Player",
    "license": "MIT",
    "keywords": [
        "anime",
        "media player",
        "video player",
        "anime player"
    ],
    "scripts": {
        "start": " electron .",
        "pack": "@electron/packager . --platform=win64 --arch=x64 --out=dist/ --overwrite --icon=icon.ico",
        "dist": "electron-builder --publish=always"
    },
    "dependencies": {
        "depcheck": "^1.4.7",
        "electron-updater": "^6.3.4",
        "ffmpeg-static": "^5.2.0",
        "fluent-ffmpeg": "^2.1.3",
        "plyr": "^3.7.8",
        "trash": "^9.0.0",
        "video.js": "^8.22.0"
    },
    "devDependencies": {
        "@electron/packager": "^18.3.5",
        "electron": "^33.2.1",
        "electron-builder": "^24.13.3",
        "webpack": "^5.94.0",
        "webpack-cli": "^5.1.4"
    },
    "build": {
        "productName": "Anime Player",
        "appId": "com.AnimePlayer",
        "target": [
            "nsis",
            {
                "target": "dmg",
                "arch": [
                    "x64"
                ]
            },
            {
                "target": "AppImage",
                "arch": [
                    "x64"
                ]
            }
        ],
        "nsis": {
            "oneClick": false,
            "perMachine": true,
            "installerIcon": "assets/icons/icon.ico",
            "uninstallerIcon": "assets/icons/icon.ico",
            "installerHeaderIcon": "assets/icons/icon.ico",
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "deleteAppDataOnUninstall": true,
            "shortcutName": "Anime Player",
            "uninstallDisplayName": "Anime Player",
            "artifactName": "Anime Player-${version}.${ext}",
            "allowElevation": true,
            "runAfterFinish": true,
            "warningsAsErrors": false,
            "include": "script/installer.nsh"
        },
        "fileAssociations": [
            {
                "ext": [
                    "3gp",
                    "avi",
                    "flv",
                    "mkv",
                    "mov",
                    "mp4",
                    "mpeg",
                    "mpg",
                    "webm",
                    "wmv",
                    "vob",
                    "ogg",
                    "m4v",
                    "iso",
                    "aac",
                    "ac3",
                    "aiff",
                    "alac",
                    "amr",
                    "ape",
                    "flac",
                    "mka",
                    "mp3",
                    "opus",
                    "wav",
                    "wma"
                ],
                "name": "Anime Player",
                "description": "Anime Player Video File",
                "icon": "assets/icons/icon.ico"
            },
            {
                "ext": "",
                "name": "Anime Player",
                "role": "Viewer"
            }
        ],
        "mac": {
            "icon": "assets/icons/icon.icns",
            "category": "public.app-category.video",
            "hardenedRuntime": true,
            "fileAssociations": [
                {
                    "ext": [
                        "3gp",
                        "avi",
                        "flv",
                        "mkv",
                        "mp4",
                        "mpeg",
                        "mpg",
                        "webm",
                        "wmv",
                        "vob",
                        "ogg",
                        "m4v",
                        "iso",
                        "aac",
                        "ac3",
                        "aiff",
                        "alac",
                        "amr",
                        "ape",
                        "flac",
                        "mka",
                        "mp3",
                        "opus",
                        "wav",
                        "wma"
                    ],
                    "name": "Anime Player",
                    "role": "Viewer"
                }
            ]
        },
        "linux": {
            "icon": "assets/icons/icon.png",
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "fileAssociations": [
                {
                    "ext": "3gp",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "avi",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "flv",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "mkv",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "mp4",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "mpeg",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "mpg",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "webm",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "wmv",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "vob",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "ogg",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
