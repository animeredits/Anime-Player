{
  "name": "anime-player",
  "version": "1.0.0",
  "description": "Anime Player offering seamless playback of audio and video files across windows and mac platforms. Features include custom controls, support for various media formats, and a user-friendly interface designed for both casual and advanced users.",
  "main": "./src/main.js",
  "author": "Anime Player",
  "license": "MIT",
  "keywords": [
    "anime",
    "media player",
    "video player",
    "audio player"
  ],
  "scripts": {
    "start": " electron .",
    "pack": "@electron/packager . --platform=win64 --arch=x64 --out=dist/ --overwrite --icon=icon.ico",
    "dist": "electron-builder --publish=always"
  },
  "dependencies": {
    "depcheck": "^1.4.7",
    "electron-log": "^5.1.7",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.4",
    "latest-version": "^9.0.0",
    "nodemon": "^3.1.9",
    "trash": "^9.0.0"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.5",
    "electron": "^33.2.1",
    "electron-builder": "^24.13.3",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  },
  "build": {
    "productName": "Anime Player",
    "appId": "com.AnimePlayer",
    "target": [
      "nsis",
      {
        "target": "dmg",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icons/icon.ico",
      "uninstallerIcon": "assets/icons/icon.ico",
      "installerHeaderIcon": "assets/icons/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true,
      "shortcutName": "Anime Player",
      "uninstallDisplayName": "Anime Player",
      "artifactName": "Anime-Player-Setup-${version}.exe"
    },
    "fileAssociations": [
      {
        "ext": [
          "3gp",
          "avi",
          "flv",
          "mkv",
          "mov",
          "mp4",
          "mpeg",
          "mpg",
          "webm",
          "wmv",
          "vob",
          "ogg",
          "m4v",
          "iso",
          "aac",
          "ac3",
          "aiff",
          "alac",
          "amr",
          "ape",
          "flac",
          "mka",
          "mp3",
          "ogg",
          "opus",
          "wav",
          "wma"
        ],
        "name": "Anime Player",
        "description": "Anime Player Video File",
        "icon": "assets/icons/icon.ico"
      }
    ],
    "mac": {
      "icon": "assets/icons/icon.icns",
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "fileAssociations": [
        {
          "ext": [
            "3gp",
            "avi",
            "flv",
            "mkv",
            "mov",
            "mp4",
            "mpeg",
            "mpg",
            "webm",
            "wmv",
            "vob",
            "ogg",
            "m4v",
            "iso",
            "aac",
            "ac3",
            "aiff",
            "alac",
            "amr",
            "ape",
            "flac",
            "mka",
            "mp3",
            "ogg",
            "opus",
            "wav",
            "wma"
          ],
          "name": "Anime Player",
          "role": "Viewer"
        }
      ]
    },
    "linux": {
      "icon": "assets/icons/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "files": [
      "**/*",
      "!**/*.map",
      "!**/tests/**",
      "!node_modules/.bin/**"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "icon": "assets/icons/icon.ico"
    }
  },
  "publish": {
    "provider": "github",
    "owner": "animeredits",
    "repo": "Anime-player"
  }
}
