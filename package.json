{
  "name": "anime-player",
  "version": "1.3.13",
  "description": "Anime Player - Desktop Media Player",
  "main": "main.js",
  "homepage": "./",
  "author": "animetedits",
  "license": "MIT",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build": "npm run compile",
    "compile": "echo 'Build step - adjust as needed for your project'",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.animetedits.animeplayer",
    "productName": "Anime Player",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "*.js",
      "*.html",
      "*.css",
      "node_modules/**/*",
      "package.json",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "certificateFile": null,
      "certificatePassword": null,
      "signingHashAlgorithms": ["sha256"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Anime Player"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "arch": ["x64", "arm64"],
      "category": "public.app-category.video",
      "certificateFile": null,
      "certificatePassword": null,
      "identity": null,
      "signIgnore": ["**"]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "arch": ["x64"],
      "category": "Video"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "${name}_${version}_${arch}.${ext}",
      "category": "Video"
    }
  },
  "dependencies": {
    "electron-updater": "^6.1.1"
  },
  "devDependencies": {
    "electron": "^26.0.0",
    "electron-builder": "^26.0.0"
  }
}