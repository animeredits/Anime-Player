{
    "name": "anime-player",
    "version": "2.1.0",
    "description": "Anime Player is an advanced player for anime enthusiasts. Enjoy your favorite anime with enhanced controls.",
    "main": "./src/main.js",
    "author": "Anime Player",
    "license": "MIT",
    "keywords": [
        "anime",
        "media player",
        "video player",
        "anime player"
    ],
    "scripts": {
        "start": "electron .",
        "dev": "cross-env NODE_ENV=development electron .",
        "pack": "electron-packager . --platform=win64 --arch=x64 --out=dist/ --overwrite --icon=icon.ico",
        "dist": "electron-builder --publish=always",
        "build": "electron-builder",
        "build:setup-only": "electron-builder --win nsis",
        "build:local": "electron-builder --win nsis --publish=never",
        "postinstall": "electron-builder install-app-deps"
    },
    "dependencies": {
        "electron-updater": "^6.3.4",
        "ffmpeg-static": "^5.3.0",
        "ffprobe-static": "^3.1.0",
        "trash": "^10.1.0"
    },
    "devDependencies": {
        "@electron/packager": "^0.0.0",
        "chokidar": "^3.5.3",
        "cross-env": "^10.1.0",
        "depcheck": "^1.4.7",
        "electron": "^39.2.7",
        "electron-builder": "^26.8.1",
        "electron-reload": "^2.0.0-alpha.1",
        "nodemon": "^3.1.9"
    },
    "overrides": {
        "minimatch": "^10.2.1",
        "glob": "^11.0.0",
        "rimraf": "^6.0.0",
        "tar": "^7.4.3"
    },
    "build": {
        "productName": "Anime Player",
        "appId": "com.AnimePlayer",
        "directories": {
            "output": "dist"
        },
        "publish": {
            "provider": "github",
            "owner": "animeredits",
            "repo": "Anime-player"
        },
        "files": [
            "!dist/**/*",
            "**/*",
            "!**/*.map",
            "!**/tests/**",
            "!node_modules/.bin/**"
        ],
        "extraResources": [
            {
                "from": "assets/",
                "to": "assets/"
            },
            {
                "from": "bin/",
                "to": "bin/"
            }
        ],
        "asar": true,
        "compression": "maximum",
        "nsis": {
            "oneClick": false,
            "perMachine": true,
            "installerIcon": "assets/icons/icon.ico",
            "uninstallerIcon": "assets/icons/icon.ico",
            "installerHeaderIcon": "assets/icons/icon.ico",
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "deleteAppDataOnUninstall": true,
            "shortcutName": "Anime Player",
            "uninstallDisplayName": "Anime Player",
            "artifactName": "Anime Player Setup ${version}.${ext}",
            "allowElevation": true,
            "runAfterFinish": true,
            "warningsAsErrors": false,
            "allowToChangeInstallationDirectory": true,
            "differentialPackage": true,
            "include": "./build/installer.nsh"
        },
        "fileAssociations": [
            {
                "ext": [
                    "mp4",
                    "mkv",
                    "avi",
                    "mov",
                    "webm",
                    "flv",
                    "wmv",
                    "m4v",
                    "mpg",
                    "mpeg"
                ],
                "name": "AnimePlayer",
                "description": "Anime Player Video File",
                "icon": "assets/icons/icon.ico",
                "role": "Player"
            },
            {
                "ext": [
                    "aac",
                    "ac3",
                    "aiff",
                    "alac",
                    "amr",
                    "ape",
                    "flac",
                    "mka",
                    "mp3",
                    "opus",
                    "wav",
                    "wma"
                ],
                "name": "Anime Player Audio",
                "description": "Anime Player Audio File",
                "icon": "assets/icons/icon.ico",
                "role": "Player"
            }
        ],
        "win": {
            "icon": "assets/icons/icon.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "verifyUpdateCodeSignature": false
        },
        "mac": {
            "icon": "assets/icons/icon.icns",
            "category": "public.app-category.video",
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "entitlements": "entitlements_mac.plist",
            "entitlementsInherit": "entitlements_mac.plist",
            "identity": null,
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "artifactName": "Anime Player-${version}-${arch}.${ext}"
        },
            "linux": {
            "icon": "assets/icons/icon.png",
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "fileAssociations": [
                {
                    "ext": "3gp",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "avi",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "flv",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "mkv",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "mp4",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "mpeg",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "mpg",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "webm",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "wmv",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "vob",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "ogg",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "m4v",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "iso",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "aac",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "ac3",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "aiff",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "alac",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "amr",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "ape",
