                    "role": "Viewer"
                },
                {
                    "ext": "mka",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "mp3",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "opus",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "wav",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "wma",
                    "name": "Anime Player",
                    "role": "Viewer"
                }
            ]
        }
    }
}
