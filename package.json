                },
                {
                    "ext": "aac",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "ac3",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "aiff",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "alac",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "amr",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "ape",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "flac",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "mka",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "mp3",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "opus",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "wav",
                    "name": "Anime Player",
                    "role": "Viewer"
                },
                {
                    "ext": "wma",
                    "name": "Anime Player",
                    "role": "Viewer"
                }
            ]
        },
        "files": [
            "!dist/**/*",
            "**/*",
            "!**/*.map",
            "!**/tests/**",
            "!node_modules/.bin/**"
        ],
        "asar": true,
        "compression": "maximum",
        "win": {
            "icon": "assets/icons/icon.ico"
        }
    },
    "publish": {
        "provider": "github",
        "owner": "animeredits",
        "repo": "Anime-player"
    }
}
