Windows Registry Editor Version 5.00

; Add "Open with Anime Player" for all files
[HKEY_CLASSES_ROOT\*\shell\Open with Anime Player]
@="Open with Anime Player"
"Icon"="C:\Program Files\Anime Player\Anime Player.exe,0"

[HKEY_CLASSES_ROOT\*\shell\Open with Anime Player\command]
@="\"C:\Program Files\Anime Player\Anime Player.exe\" \"%1\""

; Add "Open with Anime Player" for MP4 files
[HKEY_CLASSES_ROOT\SystemFileAssociations\.mp4\shell\Open with Anime Player]
@="Open with Anime Player"
"Icon"="C:\Program Files\Anime Player\Anime Player.exe,0"

[HKEY_CLASSES_ROOT\SystemFileAssociations\.mp4\shell\Open with Anime Player\command]
@="\"C:\Program Files\Anime Player\Anime Player.exe\" \"%1\""

; Add "Open with Anime Player" for MKV files
[HKEY_CLASSES_ROOT\SystemFileAssociations\.mkv\shell\Open with Anime Player]
@="Open with Anime Player"
"Icon"="C:\Program Files\Anime Player\Anime Player.exe,0"

[HKEY_CLASSES_ROOT\SystemFileAssociations\.mkv\shell\Open with Anime Player\command]
@="\"C:\Program Files\Anime Player\Anime Player.exe\" \"%1\""

; Add "Open with Anime Player" for directories
[HKEY_CLASSES_ROOT\Directory\shell\Open with Anime Player]
@="Open with Anime Player"
"Icon"="C:\Program Files\Anime Player\Anime Player.exe,0"

[HKEY_CLASSES_ROOT\Directory\shell\Open with Anime Player\command]
@="\"C:\Program Files\Anime Player\Anime Player.exe\" \"%1\""
